{% extends 'project/base.html.twig' %}
{% import 'project/contribution.html.twig' as widget %}

{% block content %}
    {% include 'project/header.html.twig' with {
        routes: [
            { name: 'About', anchor: '#about' },
        ],
        links: [],
    } %}

    <section id="home" class="relative flex flex-col max-h-94 aspect-33/10 border-2 border-zinc-900 shadow-flat bg-amber-25 scroll-mt-20">
        <img class="h-full object-cover" src="{{ asset('projects/hex_gamejam/banner.webp') }}" alt="banner image">
        <div class="absolute bg-black/50 w-full h-full"></div>
{#        <img class="absolute m-auto left-0 right-0 top-0 bottom-0 max-h-48" src="{{ asset('projects/marisol/logo.webp') }}" alt="project logo">#}
        <div class="absolute flex items-center justify-center w-full h-full">
            <p class="text-7xl text-amber-50 font-bold text-center">
                Hexagon Game Jam
            </p>
        </div>
    </section>

    <section id="about" class="flex flex-col border-2 border-zinc-900 shadow-flat bg-amber-25 scroll-mt-20">
        {# header #}
        <div class="flex items-center text-zinc-700 justify-between gap-3 px-3.5 py-2.5 w-full border-b border-stone-300 uppercase font-bold text-md">
            About the game jam
        </div>
        {# body #}
        <div class="p-6 pt-0 h-full text-lg flex flex-col gap-x-12 gap-y-4">
            {% set tags = 'BUas,Solo,XS,wren.io' %}
            {% set tags = tags|split(',') %}
            {% if tags[0] != '' %}
                <div class="flex flex-row flex-wrap mt-4 gap-2 justify-center">
                    {% for tag in tags %}
                        {% if tag|lower == 'lead programmer' %}
                            <span class="flex items-center gap-1 leading-none bg-amber-700 text-amber-25 px-2.5 py-1 rounded border border-amber-700 uppercase font-bold tracking-wide text-[11px] text-nowrap">
                            {{ ux_icon('fa6-solid:crown', {class: 'w-3 h-3 -translate-y-[2px]'}) }}
                                {{ tag }}
                        </span>
                        {% elseif tag|lower == 'commission' %}
                            <span class="flex items-center gap-1 leading-none bg-amber-700 text-amber-25 px-2.5 py-1 rounded border border-amber-700 uppercase font-bold tracking-wide text-[11px] text-nowrap">
                            {{ ux_icon('fa6-solid:brush', {class: 'w-3 h-3 -translate-y-[2px]'}) }}
                                {{ tag }}
                        </span>
                        {% else %}
                            <span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded border border-amber-300 uppercase font-semibold tracking-wide text-[11px] text-nowrap">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
            <p>
                The game jam was a one-day event split between a <span class="font-bold">hexagon math masterclass</span> and a short <span class="font-bold">two-hour jam</span> that
                followed it. I decided to create something similar to Pan'Orama or Dorf Romantic. You score points by
                <span class="font-bold">placing tiles</span> of the same type next to each other, with the next tile being <span class="font-bold">random</span> but shown in advance. Every
                x turns, a random patch of tiles is placed, and every y turns, some tiles are <span class="font-bold">destroyed</span>.
            </p>
            <p>
                We were required to make use of the XS, a tiny game engine that used the wren.io scripting language, to create the game during the jam.
            </p>
        </div>
    </section>
    <span class="flex flex-1"></span>
{% endblock %}
