{% extends 'base.html.twig' %}
{% import 'project/contribution.html.twig' as widget %}

{% block body %}
    <section id="home" class="relative flex flex-col h-94 border-2 border-zinc-900 shadow-flat bg-amber-25 scroll-mt-20">
        <img class="h-full object-cover" src="{{ asset('projects/marisol/uOeesA.png') }}" alt="portrait">
        <div class="absolute bg-black/50 w-full h-full"></div>
        <img class="absolute m-auto left-0 right-0 top-0 bottom-0 max-h-48" src="{{ asset('projects/marisol/logo.png') }}" alt="portrait">
    </section>

    <section id="about" class="flex flex-col border-2 border-zinc-900 shadow-flat bg-amber-25 scroll-mt-20">
        {# header #}
        <div class="flex items-center text-zinc-700 justify-between gap-3 px-3.5 py-2.5 w-full border-b border-stone-300 uppercase font-bold text-md">
            About Marisol
        </div>
        {# body #}
        <div class="p-6 pt-0 h-full text-lg flex flex-col gap-x-12 gap-y-4">
            {% set tags = 'BUas,Lead Programmer,Unreal Engine,Visual Scripting,Procedural Animation' %}
            {% set tags = tags|split(',') %}
            {% if tags[0] != '' %}
                <div class="flex flex-row flex-wrap mt-4 gap-2 self-center">
                    {% for tag in tags %}
                        {% if tag|lower == 'lead programmer' %}
                            <span class="flex items-center gap-1 leading-none bg-amber-700 text-amber-25 px-2.5 py-1 rounded border border-amber-700 uppercase font-bold tracking-wide text-[11px] text-nowrap">
                            {{ ux_icon('fa6-solid:crown', {class: 'w-3 h-3 -translate-y-[2px]'}) }}
                                {{ tag }}
                        </span>
                        {% elseif tag|lower == 'commission' %}
                            <span class="flex items-center gap-1 leading-none bg-amber-700 text-amber-25 px-2.5 py-1 rounded border border-amber-700 uppercase font-bold tracking-wide text-[11px] text-nowrap">
                            {{ ux_icon('fa6-solid:brush', {class: 'w-3 h-3 -translate-y-[2px]'}) }}
                                {{ tag }}
                        </span>
                        {% else %}
                            <span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded border border-amber-300 uppercase font-semibold tracking-wide text-[11px] text-nowrap">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
            <p class="text-center px-6">
                Dive into the world of Marisol to retrieve the magical crystal and save the local people. Along the way, you'll face <span class="font-bold">enemies</span> determined to hold you back and <span class="font-bold">puzzles</span> that must be solved to progress.
            </p>
            <div class="flex items-center gap-3 border-2 border-zinc-900 shadow-flat bg-indigo-100 text-zinc-700 font-semibold px-3.5 py-2.5">
                <p class="inline-block">
                    {{ ux_icon('fa6-solid:circle-check', {class: 'w-4 h-4 inline-block -translate-y-[2px]'}) }}
                    Short explanation about what I worked on, during this project.
                </p>
            </div>
        </div>
    </section>

    <div id="contributions" class="flex flex-col gap-4 scroll-mt-20">
        <div class="col-span-1 flex flex-col border-2 border-zinc-900 shadow-flat bg-amber-25 text-zinc-700 font-semibold text-xl px-3.5 py-2.5 uppercase">
            My Contributions
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {{ widget.contribution(
                title: 'Leadership',
                anchor: 'leadership',
                contributions: [
                    'the true Leader',
                    'very good skills',
                    'likable person'
                ],
            ) }}

            {{ widget.contribution(
                title: 'gameplay',
                anchor: 'gameplay',
                contributions: [
                    'Wow!',
                    'it just works.',
                    '16 times the detail!'
                ],
            ) }}

            {{ widget.contribution(
                title: 'Procedural Animation',
                anchor: 'procedural-animation',
                contributions: [
                    'It moves <span class="font-bold">fast</span>',
                    'so much work done!',
                    'There\'s nothing left to do?!'
                ],
            ) }}

            {{ widget.contribution(
                title: 'Optimization',
                anchor: 'optimization',
                contributions: [
                    '1 million FPS?!',
                    'potato pc approved.',
                ],
            ) }}
        </div>
    </div>
{% endblock %}
