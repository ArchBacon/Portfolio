{% macro contribution(
    title = "placeholder title",
    contributions = [],
    anchor,
    image,
) %}
    <section id="{{ anchor }}" class="col-span-1 flex flex-col border-2 border-zinc-900 shadow-flat bg-amber-25 scroll-mt-20">
        {# header #}
        <div class="flex items-center text-zinc-700 justify-between gap-3 px-3.5 py-2.5 w-full border-b border-stone-300 uppercase font-bold text-md">
            {{ title }}
        </div>

        {# body #}
        <div class="p-6 h-full text-lg flex flex-col gap-x-12 gap-y-4">
            <ul class="list-[square] list-inside">
                {% for contribution in contributions %}
                    <li>{{ contribution|raw }}</li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endmacro %}
