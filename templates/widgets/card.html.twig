{% macro card(
    title = "placeholder title",
    images,
    tags,
    route = 'javascript:void(0)',
    links = [],
    width = '1'
) %}
    <div class="col-span-2 {% if width == '1' %}md:col-span-1{% endif %} flex flex-col min-h-90 border-2 border-zinc-900 shadow-flat bg-amber-25">
        {# header #}
        <div
            class="flex items-center text-zinc-700 justify-between gap-3 px-3.5 py-2.5 w-full border-b border-stone-300 uppercase font-semibold text-md">
            <span class="text-zinc-700">{{ title }}</span>
        </div>

        {# body #}
        <div class="p-6 h-full text-lg flex flex-col gap-4">
            <div class="flex flex-col md:flex-row justify-center items-center gap-4">
                {% for image in images %}
                <img class="h-64 min-w-0 flex-1 object-cover border-2 border-zinc-900 shadow-flat {% if not loop.first %}hidden md:flex{% endif %}"
                     src="{{ image }}" alt="portrait">
                {% endfor %}
            </div>

            {% set tags = tags|split(',') %}
            {% if tags[0] != '' %}
                <div class="flex flex-row flex-wrap mt-4 gap-2">
                    {% for tag in tags %}
                        {% if tag|lower == 'lead programmer' %}
                            <span class="flex items-center gap-1 leading-none bg-amber-700 text-amber-25 px-2.5 py-1 rounded border border-amber-700 uppercase font-bold tracking-wide text-[11px] text-nowrap">
                                {{ ux_icon('fa6-solid:crown', {class: 'w-3 h-3 -translate-y-[2px]'}) }}
                                {{ tag }}
                            </span>
                        {% elseif tag|lower == 'commission' %}
                            <span class="flex items-center gap-1 leading-none bg-amber-700 text-amber-25 px-2.5 py-1 rounded border border-amber-700 uppercase font-bold tracking-wide text-[11px] text-nowrap">
                                {{ ux_icon('fa6-solid:brush', {class: 'w-3 h-3 -translate-y-[2px]'}) }}
                                {{ tag }}
                            </span>
                        {% else %}
                            <span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded border border-amber-300 uppercase font-semibold tracking-wide text-[11px] text-nowrap">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# footer #}
        <div class="flex items-center justify-between gap-3 px-3.5 py-2.5 w-full border-t border-stone-300 text-md min-h-10.25">
            <div class="flex flex-row gap-4">
                {% for link in links %}
                <a href="{{ link.url }}" target="{{ link.target|default('_blank') }}" title="{{ link.title }}"
                   class="text-zinc-700 hover:text-amber-700 transition-colors">
                    {{ ux_icon(link.icon, {class: "w-5 h-5 mx-auto"}) }}
                </a>
                {% endfor %}
            </div>

            {% if not (route === '' or route === '#') %}
            <a href="{{ route }}" class="group relative flex flex-row items-center uppercase font-semibold text-amber-700">
                Read more
                {{ ux_icon('lucide:arrow-up-right', {class: 'w-5 h-5 mx-auto'}) }}
                <span class="absolute left-0 -bottom-0.5 h-0.5 w-full bg-amber-700 origin-left scale-x-0 transition-transform duration-300 ease-out group-hover:scale-x-100"></span>
            </a>
            {% endif %}
        </div>
    </div>
{% endmacro %}
